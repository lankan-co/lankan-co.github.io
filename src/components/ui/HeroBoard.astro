---
/**
 * HeroBoard — a living "brand board" beside the hero headline: the kind of
 * pieces we make (mark, palette, type, a post, a growth line, a card).
 *
 * Motion, all CSS and progressive:
 *   - cards settle in one after another once the headline has risen
 *   - each card floats on its own slow loop
 *   - the board leans toward the pointer (src/scripts/reveal.ts sets --mx/--my)
 * Reduced motion → the finished board, still.
 */
import logo from '@/data/logo-paths.json';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['board', className]} data-board aria-hidden="true">
  <!-- Mark -->
  <div class="tile" style="--x:0%;--y:4%;--w:44%;--r:-7deg;--depth:1.3;--i:0;--f:7s">
    <div class="float aspect-square bg-paper p-[12%] shadow-2xl shadow-black/60">
      <svg viewBox={`0 0 ${logo.square.width} ${logo.square.height}`} class="h-full w-full">
        <path fill="#000" fill-rule="evenodd" d={logo.mark}></path>
      </svg>
    </div>
  </div>

  <!-- Palette -->
  <div class="tile" style="--x:50%;--y:0%;--w:50%;--r:4deg;--depth:0.8;--i:1;--f:8.5s">
    <div class="float rounded-2xl border border-white/10 bg-card-2 p-4 shadow-2xl shadow-black/60">
      <p class="text-[0.65rem] tracking-[0.18em] text-muted uppercase">Palette</p>
      <div class="mt-3 grid grid-cols-4 gap-1.5">
        <span class="swatch bg-ink ring-1 ring-white/15"></span>
        <span class="swatch bg-paper"></span>
        <span class="swatch bg-muted"></span>
        <span class="swatch bg-accent"></span>
      </div>
      <div class="mt-2 grid grid-cols-4 gap-1.5 font-mono text-[0.55rem] text-muted">
        <span>#000</span><span>#FFF</span><span>#A3A3A3</span><span>#60A5FA</span>
      </div>
    </div>
  </div>

  <!-- Type -->
  <div class="tile" style="--x:2%;--y:50%;--w:42%;--r:3deg;--depth:1;--i:2;--f:9s">
    <div class="float rounded-2xl border border-white/10 bg-card p-5 shadow-2xl shadow-black/60">
      <p class="text-[3.4rem] leading-none font-semibold tracking-[-0.06em]">Aa</p>
      <p class="mt-3 text-xs font-medium">DM Sans</p>
      <p class="text-[0.65rem] text-muted">Display · Text · Numerals</p>
    </div>
  </div>

  <!-- Growth -->
  <div class="tile" style="--x:48%;--y:30%;--w:52%;--r:-3deg;--depth:1.6;--i:3;--f:7.5s">
    <div class="float rounded-2xl border border-white/10 bg-card-2 p-4 shadow-2xl shadow-black/60">
      <div class="flex items-center justify-between">
        <p class="text-[0.65rem] tracking-[0.18em] text-muted uppercase">Reach</p>
        <span class="grid h-5 w-5 place-items-center rounded-full bg-accent/15 text-[0.6rem] text-accent">↗</span>
      </div>
      <svg viewBox="0 0 200 80" class="mt-3 w-full overflow-visible">
        <path d="M0 79.5 H200" stroke="currentColor" class="text-white/10" />
        <path class="grow-area" d="M0 70 C 30 66, 45 58, 70 56 S 110 40, 135 34 S 175 14, 200 8 V80 H0 Z" fill="url(#board-grad)" />
        <path class="grow-line" d="M0 70 C 30 66, 45 58, 70 56 S 110 40, 135 34 S 175 14, 200 8" fill="none" stroke="#60A5FA" stroke-width="2.5" stroke-linecap="round" pathLength="1" />
        <circle class="grow-dot" cx="200" cy="8" r="4" fill="#60A5FA" />
        <defs>
          <linearGradient id="board-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#60A5FA" stop-opacity=".28" />
            <stop offset="1" stop-color="#60A5FA" stop-opacity="0" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <!-- Post -->
  <div class="tile" style="--x:52%;--y:60%;--w:40%;--r:6deg;--depth:1.2;--i:4;--f:8s">
    <div class="float overflow-hidden rounded-2xl border border-white/10 bg-card shadow-2xl shadow-black/60">
      <div class="flex items-center gap-2 px-3 py-2.5">
        <span class="h-5 w-5 rounded-full bg-paper"></span>
        <span class="h-1.5 w-16 rounded-full bg-white/25"></span>
      </div>
      <div class="post-art relative aspect-square">
        <span class="absolute inset-[18%] rounded-full border-[6px] border-paper/90"></span>
        <span class="absolute top-1/2 left-1/2 h-[18%] w-[18%] -translate-1/2 rounded-full bg-accent"></span>
      </div>
      <div class="flex items-center gap-2 px-3 py-2.5 text-xs">
        <span class="heart text-paper">♥</span>
        <span class="h-1.5 w-10 rounded-full bg-white/25"></span>
      </div>
    </div>
  </div>

  <!-- Card -->
  <div class="tile" style="--x:0%;--y:79%;--w:50%;--r:-4deg;--depth:0.7;--i:5;--f:10s">
    <div class="float aspect-[1.75] rounded-lg bg-paper p-4 text-ink shadow-2xl shadow-black/60">
      <div class="flex h-full flex-col justify-between">
        <span class="block h-5 w-5 bg-ink"></span>
        <div>
          <p class="text-[0.7rem] font-bold tracking-tight">Your business.</p>
          <p class="text-[0.7rem] font-bold tracking-tight">Your style.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .board {
    --mx: 0;
    --my: 0;
    position: relative;
    aspect-ratio: 5 / 6;
  }
  .tile {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    rotate: var(--r);
    /* Pointer lean: deeper tiles move further, which reads as depth */
    translate: calc(var(--mx) * var(--depth) * 18px) calc(var(--my) * var(--depth) * 18px);
    transition: translate 0.9s var(--ease-out-expo);
  }
  .swatch {
    aspect-ratio: 1;
    border-radius: 0.4rem;
  }
  .post-art {
    background:
      radial-gradient(circle at 30% 25%, rgb(96 165 250 / 0.25), transparent 55%),
      linear-gradient(135deg, #171717, #0a0a0a);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile {
      animation: settle 1.2s var(--ease-out-expo) both;
      animation-delay: calc(0.75s + var(--i) * 0.11s);
    }
    .float {
      animation: float var(--f) ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * -1.3s);
    }
    .grow-line {
      stroke-dasharray: 1;
      animation: draw 2.4s var(--ease-out-expo) 1.6s both;
    }
    .grow-area {
      animation: appear 1.6s ease 2.4s both;
    }
    .grow-dot {
      transform-box: fill-box;
      transform-origin: center;
      animation:
        appear 0.4s ease 3.4s both,
        pulse 2.4s ease-in-out 3.8s infinite;
    }
    .heart {
      display: inline-block;
      animation: beat 3.2s ease-in-out 2.6s infinite;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      scale: 0.86;
      rotate: calc(var(--r) * 3);
    }
  }
  @keyframes float {
    to {
      transform: translateY(-10px);
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
  @keyframes pulse {
    50% {
      transform: scale(1.6);
      opacity: 0.6;
    }
  }
  @keyframes beat {
    0%,
    60%,
    100% {
      transform: scale(1);
      color: var(--color-paper);
    }
    66% {
      transform: scale(1.35);
      color: #f87171;
    }
    74% {
      transform: scale(1);
      color: #f87171;
    }
  }
</style>
