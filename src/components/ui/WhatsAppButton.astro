---
/** Floating WhatsApp chat button, bottom-right on every page. */
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { chatMessage, site, whatsappHref } from '@/data/site';
---

<a
  href={whatsappHref(chatMessage)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Chat with us on WhatsApp at ${site.phone.display} (opens in a new tab)`}
  title="Chat on WhatsApp"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 grid h-13 w-13 place-items-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-transform duration-300 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink motion-reduce:transition-none motion-reduce:hover:scale-100 md:right-6 md:bottom-6 md:h-14 md:w-14"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>
