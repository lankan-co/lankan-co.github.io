---
/**
 * Work grid card: cover photo, centred title, date and outlined category tag.
 * On hover/focus the photo darkens and a "View project" button appears.
 */
import { Picture } from 'astro:assets';
import { href } from '@/data/paths';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  /** Eager-load covers that are likely above the fold. */
  eager?: boolean;
}
const { project: p, eager = false } = Astro.props;
---

<li data-category={p.category} data-reveal>
  <a href={href(`work/${p.slug}/`)} class="card group block">
    <div class="relative aspect-[3/2] overflow-hidden bg-line">
      <Picture
        src={p.cover}
        alt={p.coverAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
        class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span
        aria-hidden="true"
        class="absolute inset-0 grid place-items-center bg-black/55 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
      >
        <span class="label border border-white px-6 py-3 text-white">View project</span>
      </span>
    </div>
    <div class="mt-6 text-center">
      <h3 class="label text-sm text-ink">{p.title}</h3>
      <p class="meta mt-2">{p.dateLabel}</p>
      <span class="tag mt-3">{p.category}</span>
    </div>
  </a>
</li>
