---
/**
 * How we work — 4 steps. A hairline fills as you scroll through the section
 * (driven by Framer Motion's scroll() in src/scripts/reveal.ts via --progress).
 * Horizontal on desktop, vertical on mobile.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { process } from '@/data/site';
---

<section id="process" aria-labelledby="process-title" class="relative border-t border-line py-28 md:py-40">
  <div class="container-site">
    <SectionHeading
      id="process-title"
      index="03"
      label="Process"
      title="A simple process, done properly."
      lede="Four clear stages, one small team, and you in the loop the whole way. No surprises, no disappearing acts."
    />

    <div class="relative mt-16 lg:mt-24" data-progress>
      <!-- Track + progress (vertical on mobile, horizontal on desktop) -->
      <div aria-hidden="true" class="absolute top-2 bottom-2 left-[7px] w-px bg-line lg:top-[7px] lg:right-0 lg:bottom-auto lg:left-0 lg:h-px lg:w-auto">
        <div class="progress-fill absolute inset-0 bg-paper"></div>
      </div>

      <ol class="relative grid gap-14 lg:grid-cols-4 lg:gap-10" data-reveal-group>
        {
          process.map((step, i) => (
            <li class="relative pl-12 lg:pl-0 lg:pt-14" data-reveal>
              <span
                aria-hidden="true"
                class="absolute top-0.5 left-0 h-[15px] w-[15px] rounded-full border border-paper bg-ink lg:top-0"
              />
              <p class="font-mono text-xs tracking-widest text-muted">STEP {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-3xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-4 max-w-xs leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .progress-fill {
    transform-origin: top;
    transform: scaleY(var(--progress, 1));
  }
  @media (min-width: 1024px) {
    .progress-fill {
      transform-origin: left;
      transform: scaleX(var(--progress, 1));
    }
  }
</style>
