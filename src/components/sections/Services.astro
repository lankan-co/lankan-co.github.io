---
/**
 * Services — six cards. On hover/focus (pointer devices) the detail line
 * unfolds; on touch devices it's always visible so nothing is hidden.
 * A soft spotlight follows the pointer across each card (--sx/--sy are set
 * by src/scripts/reveal.ts → initSpotlight).
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { services } from '@/data/site';
---

<section id="services" aria-labelledby="services-title" class="relative border-t border-line py-28 md:py-40">
  <div class="container-site">
    <SectionHeading
      id="services-title"
      index="02"
      label="Services"
      title="Everything your brand needs. Nothing it doesn’t."
      lede="Pick one thing or let us take care of the lot. Every engagement is shaped around your stage, your budget and your goals."
    />

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:mt-24 lg:grid-cols-3" data-reveal-group data-spotlight>
      {
        services.map((s, i) => (
          <li data-reveal class="service card group relative flex flex-col overflow-hidden p-8 transition-[background-color,border-color,transform] duration-500 hover:-translate-y-1 hover:border-white/20 hover:bg-card-2 focus-within:border-white/20 md:min-h-[19rem] md:p-10">
            {/* soft light that follows the pointer */}
            <span aria-hidden="true" class="spot pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
            <div class="flex items-start justify-between">
              <span class="font-mono text-xs tracking-widest text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span
                aria-hidden="true"
                class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-sm transition-all duration-500 group-hover:rotate-45 group-hover:border-paper group-hover:bg-paper group-hover:text-ink"
              >
                ↗
              </span>
            </div>
            <h3 class="pt-16 text-2xl font-semibold tracking-tight">{s.title}</h3>
            <p class="mt-2 text-muted">{s.summary}</p>
            <div class="service-detail grid">
              <div class="overflow-hidden">
                <p class="pt-5 text-sm leading-relaxed text-neutral-300">{s.detail}</p>
                <a
                  href="#contact"
                  class="link-draw mt-4 inline-block text-sm text-paper"
                  aria-label={`Talk to us about ${s.title}`}
                >
                  Talk to us about this
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .spot {
    background:
      radial-gradient(22rem circle at var(--sx, 80%) var(--sy, 0%), rgb(255 255 255 / 0.07), transparent 60%),
      radial-gradient(10rem circle at var(--sx, 80%) var(--sy, 0%), rgb(96 165 250 / 0.08), transparent 70%);
  }
  /* Hover/focus reveal only where hover exists */
  @media (hover: hover) and (pointer: fine) {
    .service-detail {
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.6s var(--ease-out-expo),
        opacity 0.5s var(--ease-out-expo);
    }
    .service:hover .service-detail,
    .service:focus-within .service-detail {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
</style>
