---
/**
 * Showcase — "Your brand, everywhere": the touchpoints we design for,
 * drawn as small animated illustrations (no stock imagery to license).
 *
 * Desktop with motion: the section pins and the row slides sideways as you
 * scroll (src/scripts/reveal.ts → initHorizontalScroll). Everywhere else it's
 * a native, swipeable scroll-snap row — fully usable without JavaScript.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import logo from '@/data/logo-paths.json';
import { touchpoints } from '@/data/site';

const sq = logo.square;
---

<section id="touchpoints" aria-labelledby="touchpoints-title" class="relative border-t border-line">
  <div data-hscroll>
    <div data-hscroll-stage class="overflow-hidden py-28 md:py-40 lg:sticky lg:top-0 lg:flex lg:h-[100svh] lg:flex-col lg:justify-center lg:pt-20 lg:pb-6">
      <div class="container-site">
        <SectionHeading
          id="touchpoints-title"
          index="03"
          label="Touchpoints"
          title="Your brand, everywhere it matters."
          lede="One consistent voice across every touchpoint — from the logo on your door to the ad in someone’s feed."
        />
      </div>

      <div data-hscroll-viewport class="no-scrollbar mt-14 snap-x snap-mandatory overflow-x-auto lg:mt-12 lg:shrink-0">
        <ul data-hscroll-track class="track flex w-max gap-5 md:gap-6">
          {
            touchpoints.map((t, i) => (
              <li class="tp card group w-[min(82vw,30rem)] shrink-0 snap-start overflow-hidden lg:w-[min(30rem,max(17rem,calc((100svh-33rem)*1.45)))]">
                <div class="art relative aspect-[16/11] overflow-hidden border-b border-line bg-card-2">
                  {t.art === 'identity' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <g class="spin" style="transform-origin:200px 137px">
                        <circle cx="200" cy="137" r="112" fill="none" stroke="rgb(255 255 255 / .14)" stroke-dasharray="3 7" />
                        <circle cx="200" cy="137" r="86" fill="none" stroke="rgb(96 165 250 / .5)" stroke-dasharray="1 5" />
                      </g>
                      <path d="M40 137 H360 M200 15 V259" stroke="rgb(255 255 255 / .1)" />
                      <g transform={`translate(146 83) scale(${108 / sq.width})`}>
                        <rect width={sq.width} height={sq.height} fill="#fff" />
                        <path fill="#000" fill-rule="evenodd" d={logo.mark} />
                      </g>
                      <g fill="rgb(255 255 255 / .55)" font-size="9" font-family="ui-monospace, monospace">
                        <text x="268" y="80">x = 1 module</text>
                        <text x="60" y="210">clear space 0.5x</text>
                      </g>
                      <circle class="blip" cx="286" cy="137" r="4" fill="#60A5FA" />
                    </svg>
                  )}
                  {t.art === 'packaging' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <ellipse cx="200" cy="246" rx="150" ry="10" fill="rgb(0 0 0 / .6)" />
                      {/* pouch */}
                      <g class="bob">
                        <path d="M120 60 H230 L240 240 H110 Z" fill="#F5F5F5" />
                        <path d="M120 60 H230 V74 H120 Z" fill="#d4d4d4" />
                        <rect x="126" y="120" width="98" height="78" fill="#0a0a0a" />
                        <text x="175" y="152" fill="#fff" font-size="13" font-weight="700" text-anchor="middle" letter-spacing="-.4">Your brand</text>
                        <text x="175" y="170" fill="#a3a3a3" font-size="7.5" text-anchor="middle" letter-spacing="1.5">SMALL BATCH</text>
                        <circle cx="175" cy="184" r="4" fill="#60A5FA" />
                      </g>
                      {/* box */}
                      <g class="bob" style="animation-delay:-1.4s">
                        <path d="M236 150 L300 128 L352 146 L288 170 Z" fill="#e5e5e5" />
                        <path d="M236 150 L288 170 V242 L236 222 Z" fill="#cfcfcf" />
                        <path d="M288 170 L352 146 V218 L288 242 Z" fill="#fff" />
                        <path d="M300 186 L340 171 V196 L300 211 Z" fill="#0a0a0a" />
                      </g>
                    </svg>
                  )}
                  {t.art === 'social' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <rect x="140" y="18" width="120" height="240" rx="20" fill="#0a0a0a" stroke="rgb(255 255 255 / .22)" />
                      <rect x="180" y="26" width="40" height="6" rx="3" fill="rgb(255 255 255 / .2)" />
                      <circle cx="160" cy="50" r="7" fill="#fff" />
                      <rect x="172" y="47" width="44" height="5" rx="2.5" fill="rgb(255 255 255 / .35)" />
                      {Array.from({ length: 9 }, (_, k) => (
                        <rect
                          class="post"
                          style={`animation-delay:${k * 0.18}s`}
                          x={150 + (k % 3) * 34}
                          y={68 + Math.floor(k / 3) * 34}
                          width="32"
                          height="32"
                          fill={k === 4 ? '#60A5FA' : k % 2 ? '#262626' : '#F5F5F5'}
                        />
                      ))}
                      <rect x="150" y="176" width="100" height="6" rx="3" fill="rgb(255 255 255 / .18)" />
                      <rect x="150" y="188" width="70" height="6" rx="3" fill="rgb(255 255 255 / .12)" />
                      <text class="like" x="280" y="96" fill="#f87171" font-size="22">♥</text>
                      <text class="like" style="animation-delay:1.1s" x="100" y="150" fill="#fff" font-size="16">♥</text>
                    </svg>
                  )}
                  {t.art === 'web' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <rect x="40" y="28" width="320" height="218" rx="12" fill="#0a0a0a" stroke="rgb(255 255 255 / .2)" />
                      <path d="M40 54 H360" stroke="rgb(255 255 255 / .12)" />
                      <circle cx="58" cy="41" r="4" fill="rgb(255 255 255 / .25)" />
                      <circle cx="72" cy="41" r="4" fill="rgb(255 255 255 / .25)" />
                      <circle cx="86" cy="41" r="4" fill="rgb(255 255 255 / .25)" />
                      <rect x="62" y="80" width="160" height="14" rx="3" fill="#fff" />
                      <rect x="62" y="102" width="120" height="14" rx="3" fill="#fff" />
                      <rect x="62" y="128" width="140" height="6" rx="3" fill="rgb(255 255 255 / .3)" />
                      <rect x="62" y="140" width="110" height="6" rx="3" fill="rgb(255 255 255 / .3)" />
                      <rect class="cta" x="62" y="164" width="82" height="24" rx="12" fill="#fff" />
                      <text x="103" y="180" fill="#000" font-size="9" font-weight="700" text-anchor="middle">Enquire →</text>
                      <rect x="246" y="78" width="92" height="112" rx="8" fill="#171717" />
                      <circle cx="292" cy="128" r="24" fill="none" stroke="#60A5FA" stroke-width="5" />
                      <g class="cursor">
                        <path d="M0 0 L0 17 L5 12 L9 20 L12 18.5 L8 11 L14 11 Z" fill="#fff" stroke="#000" stroke-width="1" />
                      </g>
                    </svg>
                  )}
                  {t.art === 'storefront' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <rect x="60" y="40" width="280" height="210" fill="#141414" />
                      <rect x="96" y="54" width="208" height="34" fill="#F5F5F5" />
                      <text x="200" y="77" fill="#000" font-size="17" font-weight="700" text-anchor="middle" letter-spacing="-.5">Your brand</text>
                      {Array.from({ length: 8 }, (_, k) => (
                        <path d={`M${60 + k * 35} 98 h35 l-4 26 h-27 Z`} fill={k % 2 ? '#0a0a0a' : '#F5F5F5'} />
                      ))}
                      <rect x="84" y="138" width="130" height="94" fill="#0a0a0a" stroke="rgb(255 255 255 / .2)" />
                      <path class="glint" d="M100 228 L150 142 H170 L120 228 Z" fill="rgb(255 255 255 / .06)" />
                      <rect x="238" y="138" width="78" height="112" fill="#0a0a0a" stroke="rgb(255 255 255 / .2)" />
                      <circle cx="302" cy="196" r="3" fill="#a3a3a3" />
                      <rect class="open" x="104" y="150" width="46" height="18" rx="9" fill="none" stroke="#60A5FA" stroke-width="2" />
                      <text class="open" x="127" y="163" fill="#60A5FA" font-size="9" font-weight="700" text-anchor="middle">OPEN</text>
                      <rect x="40" y="250" width="320" height="6" fill="#262626" />
                    </svg>
                  )}
                  {t.art === 'campaigns' && (
                    <svg viewBox="0 0 400 275" class="h-full w-full" aria-hidden="true">
                      <g transform="rotate(-6 130 140)">
                        <rect x="56" y="58" width="150" height="160" rx="10" fill="#F5F5F5" />
                        <rect x="56" y="58" width="150" height="96" rx="10" fill="#0a0a0a" />
                        <circle cx="131" cy="106" r="26" fill="none" stroke="#fff" stroke-width="6" />
                        <circle cx="131" cy="106" r="7" fill="#60A5FA" />
                        <rect x="70" y="168" width="90" height="8" rx="4" fill="#0a0a0a" />
                        <rect x="70" y="184" width="60" height="6" rx="3" fill="#a3a3a3" />
                        <rect x="150" y="190" width="44" height="16" rx="8" fill="#0a0a0a" />
                      </g>
                      <path d="M226 226 H354" stroke="rgb(255 255 255 / .2)" />
                      {[38, 58, 50, 82, 108, 136].map((h, k) => (
                        <rect class="bar" style={`animation-delay:${k * 0.12}s`} x={232 + k * 20} y={226 - h} width="12" height={h} rx="3" fill={k === 5 ? '#60A5FA' : 'rgb(255 255 255 / .75)'} />
                      ))}
                    </svg>
                  )}
                </div>
                <div class="flex items-start gap-5 p-6 md:p-7">
                  <span class="pt-1 font-mono text-xs tracking-widest text-muted">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="text-2xl font-semibold tracking-tight">{t.title}</h3>
                    <p class="mt-2 leading-relaxed text-muted">{t.body}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="container-site mt-8 flex items-center gap-5 text-xs text-muted">
        <span class="hidden lg:inline">Keep scrolling</span>
        <span class="lg:hidden">Swipe to explore</span>
        <span class="relative h-px flex-1 overflow-hidden bg-line" aria-hidden="true">
          <span data-hscroll-bar class="absolute inset-0 origin-left scale-x-[var(--progress,0.16)] bg-paper"></span>
        </span>
        <span class="font-mono tracking-widest">0{touchpoints.length}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Line the first card up with the page grid; leave room after the last */
  .track {
    padding-inline: max(1.25rem, calc((100vw - 84rem) / 2 + 1.25rem));
  }
  @media (min-width: 768px) {
    .track {
      padding-inline: max(2.5rem, calc((100vw - 84rem) / 2 + 2.5rem));
    }
  }
  .track > li {
    scroll-margin-inline: max(1.25rem, calc((100vw - 84rem) / 2 + 1.25rem));
  }
  /* Short laptop screens: a tighter heading so the pinned row fits */
  @media (min-width: 1024px) and (max-height: 860px) {
    #touchpoints :global(h2) {
      font-size: 3rem;
    }
  }
  .tp {
    transition:
      border-color 0.5s,
      transform 0.6s var(--ease-out-expo);
  }
  .tp:hover {
    border-color: rgb(255 255 255 / 0.2);
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spin {
      animation: spin 30s linear infinite;
    }
    .blip {
      animation: blink 1.8s ease-in-out infinite;
    }
    .bob {
      animation: bob 4s ease-in-out infinite alternate;
    }
    .post {
      animation: post 5.4s ease-in-out infinite;
    }
    .like {
      animation: like 3.2s ease-out infinite;
    }
    .cursor {
      animation: cursor 4.5s var(--ease-out-expo) infinite;
    }
    .cta {
      transform-box: fill-box;
      transform-origin: center;
      animation: press 4.5s ease infinite;
    }
    .open {
      animation: blink 2.6s steps(2, jump-none) infinite;
    }
    .glint {
      animation: glint 5s ease-in-out infinite;
    }
    .bar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: grow 3.6s var(--ease-out-expo) infinite;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes bob {
    to {
      transform: translateY(-6px);
    }
  }
  @keyframes post {
    0%,
    8% {
      opacity: 0;
    }
    18%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes like {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    20% {
      opacity: 1;
    }
    60%,
    100% {
      opacity: 0;
      transform: translateY(-34px);
    }
  }
  @keyframes cursor {
    0% {
      transform: translate(300px, 220px);
    }
    45%,
    100% {
      transform: translate(118px, 178px);
    }
  }
  @keyframes press {
    0%,
    44% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.92);
    }
    58%,
    100% {
      transform: scale(1);
    }
  }
  @keyframes glint {
    0%,
    100% {
      transform: translateX(-30px);
      opacity: 0;
    }
    50% {
      transform: translateX(70px);
      opacity: 1;
    }
  }
  @keyframes grow {
    0% {
      transform: scaleY(0.1);
    }
    40%,
    85% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(0.1);
    }
  }
</style>
