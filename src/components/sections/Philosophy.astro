---
/** Philosophy / About — one strong statement and four values. */
import { values } from '@/data/site';

// Minimal geometric glyphs that echo the circle + square of the mark.
const glyphs = [
  '<circle cx="16" cy="16" r="11" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="16" cy="16" r="3" fill="currentColor"/>',
  '<rect x="7" y="7" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="13" y="13" width="6" height="6" fill="currentColor"/>',
  '<path d="M5 24 L13 15 L18 19 L27 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="27" cy="8" r="2.5" fill="currentColor"/>',
  '<path d="M16 5 A11 11 0 1 1 5 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5 9 V16 H12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
];
---

<section id="philosophy" aria-labelledby="philosophy-title" class="relative py-28 md:py-44">
  <div class="container-site">
    <p class="eyebrow" data-reveal>01 — Philosophy</p>

    <h2
      id="philosophy-title"
      class="mt-8 max-w-[22ch] text-[clamp(2rem,4.6vw,4.25rem)] leading-[1.06] font-semibold tracking-[-0.035em]"
      data-reveal
    >
      Big agencies build brands for big companies.
      <span class="text-muted">We build them for the bakery, the studio, the side project that became the main thing —</span>
      the businesses that are truly someone’s own.
    </h2>

    <div class="mt-16 grid gap-10 md:mt-20 md:grid-cols-12">
      <p class="text-lg leading-relaxed text-muted md:col-span-5 md:col-start-8" data-reveal>
        We’re founders too, so we know what it costs to put your name on something. That’s why we keep our
        studio small, our process honest and our work grounded in what makes <em class="text-paper not-italic">you</em>
        different. No jargon. No templates. Just a brand with your fingerprints all over it.
      </p>
    </div>

    <ul class="mt-20 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {
        values.map((v, i) => (
          <li class="group relative bg-card p-8 transition-colors duration-500 hover:bg-card-2 md:p-10" data-reveal>
            <svg
              viewBox="0 0 32 32"
              class="h-8 w-8 text-paper transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-rotate-12 group-hover:scale-110"
              aria-hidden="true"
              set:html={glyphs[i]}
            />
            <h3 class="mt-10 text-xl font-semibold tracking-tight">{v.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{v.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
