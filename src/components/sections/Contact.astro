---
/** Final CTA + contact form (React island, hydrates when visible; emails enquiries via Web3Forms). */
import ContactForm from '@/components/islands/ContactForm';
import Magnetic from '@/components/islands/Magnetic';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { enquiry, services, site, whatsappHref } from '@/data/site';

// Where Web3Forms sends visitors after a no-JavaScript submission.
const thanksUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}thanks/`, Astro.site).href;

const callHref = `mailto:${site.email}?subject=${encodeURIComponent('Discovery call')}&body=${encodeURIComponent(
  'Hi Lankan team,\n\nI’d love to book a free 30-minute discovery call. A few times that suit me:\n\n- \n- \n\nThanks!',
)}`;
const chatHref = whatsappHref(`Hi ${site.name}, I’d like to talk about a project.`);
---

<section id="contact" aria-labelledby="contact-title" class="bg-grain relative isolate overflow-hidden border-t border-line py-28 md:py-40">
  <div aria-hidden="true" class="bg-bands absolute inset-0 -z-10 opacity-60"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-ink via-ink/40 to-ink"></div>

  <div class="container-site grid gap-16 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal>06 — Start a project</p>
      <h2
        id="contact-title"
        class="mt-8 text-[clamp(2.5rem,5.6vw,5rem)] leading-[1] font-semibold tracking-[-0.045em]"
        data-reveal
      >
        Let’s build something that’s unmistakably yours.
      </h2>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-muted" data-reveal>
        Tell us where you are and where you want to go. We’ll come back within one working day with honest thoughts
        — even if we’re not the right fit.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal>
        <Magnetic client:idle>
          <a href={chatHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            <WhatsAppIcon class="h-5 w-5" />
            Chat on WhatsApp
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </Magnetic>
        <a href={callHref} class="btn btn-ghost">
          Book a free discovery call <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6 text-sm" data-reveal>
        <div>
          <dt class="text-xs tracking-[0.18em] text-muted uppercase">Call or WhatsApp</dt>
          <dd class="mt-2"><a href={`tel:${site.phone.e164}`} class="link-draw text-base text-paper">{site.phone.display}</a></dd>
        </div>
        <div>
          <dt class="text-xs tracking-[0.18em] text-muted uppercase">Email</dt>
          <dd class="mt-2"><a href={`mailto:${site.email}`} class="link-draw text-base text-paper">{site.email}</a></dd>
        </div>
      </dl>
    </div>

    <div class="lg:col-span-6 lg:col-start-7" data-reveal>
      <ContactForm
        client:visible
        accessKey={site.web3formsKey}
        email={site.email}
        whatsappUrl={chatHref}
        siteName={site.name}
        redirectUrl={thanksUrl}
        services={services.map((s) => s.title)}
        budgets={enquiry.budgets}
        timelines={enquiry.timelines}
      />
    </div>
  </div>
</section>
