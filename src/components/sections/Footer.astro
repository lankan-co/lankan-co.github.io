---
/** Black footer: brand line, pages, contact details, social links and copyright. */
import Logo from '@/components/ui/Logo.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { href } from '@/data/paths';
import { chatMessage, nav, site, socialLinks as social, whatsappHref } from '@/data/site';

const year = new Date().getFullYear();
---

<!-- Extra bottom room keeps the floating WhatsApp button clear of the last row -->
<footer class="border-t border-white/10 bg-night pt-20 pb-28 text-white md:pb-12">
  <div class="container-site">
    <div class="grid gap-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo tone="light" class="h-10 w-auto md:h-12" />
        <p class="mt-6 max-w-xs leading-relaxed text-white/60">{site.tagline}. Based in {site.location}, working worldwide.</p>
      </div>

      <nav aria-label="Footer" class="md:col-span-2">
        <h2 class="label text-white/50">Studio</h2>
        <ul class="mt-6 space-y-3">
          {
            nav.map((n) => (
              <li>
                <a href={href(n.path)} class="link-draw text-white/85 hover:text-white">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="label text-white/50">Contact</h2>
        <ul class="mt-6 space-y-3 text-white/85">
          <li><a href={`mailto:${site.email}`} class="link-draw hover:text-white">{site.email}</a></li>
          <li><a href={`tel:${site.phone.e164}`} class="link-draw hover:text-white">{site.phone.display}</a></li>
          <li>
            <a href={whatsappHref(chatMessage)} class="link-draw inline-flex items-center gap-2 hover:text-white" target="_blank" rel="noopener noreferrer">
              <WhatsAppIcon class="h-4 w-4 text-[#25D366]" />
              WhatsApp
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
          <li class="text-white/60">{site.location}</li>
        </ul>
      </div>

      {
        social.length > 0 && (
          <div class="md:col-span-2">
            <h2 class="label text-white/50">Follow</h2>
            <ul class="mt-6 space-y-3">
              {social.map((s) => (
                <li>
                  <a href={s.href} class="group inline-flex items-center gap-3 text-white/85 hover:text-white" rel="me noopener noreferrer" target="_blank">
                    <SocialIcon name={s.icon} class="h-4 w-4 shrink-0 text-white/60 transition-colors group-hover:text-white" />
                    <span class="link-draw">{s.label}</span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <div class="mt-20 border-t border-white/10 pt-8 text-center">
      <p class="label text-[0.65rem] font-normal text-white/40">© {year} {site.name} All rights reserved.</p>
    </div>
  </div>
</footer>
