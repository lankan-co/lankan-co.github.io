---
/**
 * Sticky header: logo left, uppercase page links centred, "Start a project"
 * pill right. On phones the links move into a full-screen menu.
 */
import Logo from '@/components/ui/Logo.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { href } from '@/data/paths';
import { chatMessage, nav, site, whatsappHref } from '@/data/site';

const here = Astro.url.pathname;
const isCurrent = (path: string) => here.startsWith(href(path));
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-transparent bg-paper/90 backdrop-blur-md transition-colors duration-300 data-[scrolled]:border-line"
>
  <div class="container-site flex h-16 items-center justify-between gap-6 md:h-20">
    <a href={href()} class="relative z-[60] -m-2 rounded p-2" aria-label={`${site.name} — home`}>
      <Logo class="h-7 w-auto md:h-8" />
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
                class="label link-draw text-ink/70 transition-colors hover:text-ink aria-[current]:text-ink aria-[current]:[background-size:100%_1px]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={href('contact/')} class="btn btn-primary hidden min-h-10 px-6 md:inline-flex">Start a project</a>
      <button
        type="button"
        data-menu-toggle
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        class="group relative z-[60] grid h-11 w-11 place-items-center md:hidden"
      >
        <span
          aria-hidden="true"
          class="absolute h-px w-6 -translate-y-1 bg-ink transition-transform duration-300 group-aria-expanded:translate-y-0 group-aria-expanded:rotate-45"
        ></span>
        <span
          aria-hidden="true"
          class="absolute h-px w-6 translate-y-1 bg-ink transition-transform duration-300 group-aria-expanded:translate-y-0 group-aria-expanded:-rotate-45"
        ></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: full-screen, large type. Lives outside <header>, whose backdrop blur would trap a fixed child. -->
  <div
    id="mobile-menu"
    inert
    class="pointer-events-none fixed inset-0 z-40 flex flex-col bg-paper opacity-0 transition-opacity duration-300 data-[open]:pointer-events-auto data-[open]:opacity-100 md:hidden"
  >
    <nav aria-label="Mobile" class="container-site flex flex-1 flex-col justify-center pt-16">
      <ul class="space-y-3">
        <li><a href={href()} class="block py-1 text-4xl font-light tracking-tight uppercase">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.path)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
                class="block py-1 text-4xl font-light tracking-tight uppercase aria-[current]:font-normal"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 flex flex-wrap gap-3">
        <a href={href('contact/')} class="btn btn-primary">Start a project</a>
        <a href={whatsappHref(chatMessage)} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
          <WhatsAppIcon class="h-4 w-4" />
          WhatsApp
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </nav>
  </div>
