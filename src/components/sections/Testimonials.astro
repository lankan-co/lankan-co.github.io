---
/** Testimonials — three quotes as <figure>/<blockquote>. PLACEHOLDER copy. */
import { testimonials } from '@/data/site';
---

<section aria-labelledby="testimonials-title" class="relative border-t border-line py-28 md:py-40">
  <div class="container-site">
    <p class="eyebrow" data-reveal>05 — Kind words</p>
    <h2 id="testimonials-title" class="sr-only">What our clients say</h2>

    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-x-10 md:gap-y-16" data-reveal-group>
      {
        testimonials.map((t, i) => (
          <figure
            data-reveal
            class:list={[
              'flex flex-col border-t border-line pt-8',
              i === 0 && 'md:col-span-2 md:max-w-5xl md:border-0 md:pt-0',
            ]}
          >
            <svg viewBox="0 0 40 32" class="h-6 w-8 text-white/25" aria-hidden="true" fill="currentColor">
              <path d="M0 32V19.2C0 8.4 6.1 1.6 16 0l1.6 4.4C11.7 6 8.8 9.8 8.6 15.2H16V32H0zm24 0V19.2C24 8.4 30.1 1.6 40 0l-0.0 4.4c-5.9 1.6-8.8 5.4-9 10.8H40V32H24z" />
            </svg>
            <blockquote
              class:list={[
                'mt-6 leading-snug font-medium tracking-tight',
                i === 0 ? 'text-[clamp(1.6rem,3.4vw,3rem)] leading-[1.12] tracking-[-0.03em]' : 'text-xl md:text-2xl',
              ]}
            >
              <p>“{t.quote}”</p>
            </blockquote>
            <figcaption class="mt-auto flex items-center gap-4 pt-8">
              <span
                aria-hidden="true"
                class="grid h-10 w-10 place-items-center rounded-full bg-paper text-sm font-semibold text-ink"
              >
                {t.name.charAt(0)}
              </span>
              <span>
                <span class="block font-medium">{t.name}</span>
                <span class="block text-sm text-muted">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
