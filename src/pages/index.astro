---
/**
 * Home — short and simple: intro, selected work (once projects exist),
 * who we work with, a services teaser and a call to action.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { href } from '@/data/paths';
import { featured } from '@/data/projects';
import { audiences, services, site } from '@/data/site';
---

<BaseLayout>
  <section aria-labelledby="hero-title" class="container-site pt-16 pb-24 md:pt-28 md:pb-32">
    <p class="label text-muted">Branding & digital marketing studio · {site.location}</p>
    <h1 id="hero-title" class="page-title mt-8">Your business.<br />Your style.</h1>
    <p class="mt-10 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
      A boutique branding and digital marketing studio for businesses of every size — from first-time founders to
      established companies. We make brands that feel like you, and help the right people find them.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={href('contact/')} class="btn btn-primary">Start a project <span class="btn-arrow" aria-hidden="true">→</span></a>
      <a href={href(featured.length ? 'work/' : 'services/')} class="btn btn-ghost">{featured.length ? 'See our work' : 'Our services'}</a>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section aria-labelledby="work-title" class="border-t border-line">
        <div class="container-site py-20 md:py-28">
          <div class="flex items-end justify-between gap-6">
            <h2 id="work-title" class="label text-muted">Selected work</h2>
            <a href={href('work/')} class="label link-draw text-ink">
              View all work →
            </a>
          </div>
          <ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {featured.map((p, i) => <ProjectCard project={p} eager={i === 0} />)}
          </ul>
        </div>
      </section>
    )
  }

  <section aria-labelledby="for-title" class="border-t border-line">
    <div class="container-site py-20 md:py-28">
      <div class="grid gap-6 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="label text-muted">Who we work with</p>
          <h2 id="for-title" class="mt-6 text-[clamp(1.75rem,3.6vw,3rem)] leading-[1.1] font-light tracking-[-0.02em]">
            From a first idea to a name everyone knows.
          </h2>
        </div>
        <p class="leading-relaxed text-muted md:col-span-4 md:col-start-9">
          Start-up, family business or established company — we shape the brand around who you are, not around a house
          style.
        </p>
      </div>
      <ul class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          audiences.map((a, i) => (
            <li class="border-t border-ink pt-6" data-reveal>
              <p class="meta">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-xl font-light tracking-tight uppercase">{a.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{a.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="services-title" class="border-t border-line">
    <div class="container-site py-20 md:py-28">
      <div class="flex items-end justify-between gap-6">
        <h2 id="services-title" class="label text-muted">Services</h2>
        <a href={href('services/')} class="label link-draw text-ink">All services →</a>
      </div>
      <ul class="mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li class="border-b border-line py-6 sm:pr-6" data-reveal>
              <p class="meta">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-xl font-light tracking-tight uppercase">{s.title}</h3>
              <p class="mt-2 text-muted">{s.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
