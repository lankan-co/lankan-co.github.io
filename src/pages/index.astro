---
/**
 * Cokan Brands & Co. — single-page site.
 * Sections are self-contained components; copy lives in src/data/site.ts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CursorGlow from '@/components/islands/CursorGlow';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Philosophy from '@/components/sections/Philosophy.astro';
import Services from '@/components/sections/Services.astro';
import Process from '@/components/sections/Process.astro';
import Work from '@/components/sections/Work.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Contact from '@/components/sections/Contact.astro';
import Footer from '@/components/sections/Footer.astro';
---

<BaseLayout>
  <CursorGlow client:idle />
  <Header />
  <main id="main" class="relative z-10">
    <Hero />
    <Philosophy />
    <Services />
    <Process />
    <Work />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
