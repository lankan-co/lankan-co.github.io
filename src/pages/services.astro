---
/** Services — what we do, how a project runs, and common questions. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { faqs, process, services } from '@/data/site';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Services"
  description="Branding, digital marketing strategy, social media, SEO, paid advertising and creative direction for small businesses."
>
  <section aria-labelledby="page-title" class="container-site pt-16 pb-16 md:pt-28 md:pb-20">
    <h1 id="page-title" class="page-title">Services</h1>
    <p class="mt-10 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
      Everything your brand needs, nothing it doesn’t. Pick one thing or let us take care of the lot — every
      engagement is shaped around your stage, your budget and your goals.
    </p>
  </section>

  <section aria-label="Our services" class="container-site pb-20 md:pb-28">
    <ul class="border-t border-line">
      {
        services.map((s, i) => (
          <li class="grid gap-3 border-b border-line py-8 md:grid-cols-12 md:gap-6 md:py-10" data-reveal>
            <p class="meta md:col-span-1 md:pt-2">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="text-2xl font-light tracking-tight uppercase md:col-span-4 md:text-3xl">{s.title}</h2>
            <div class="md:col-span-6 md:col-start-7">
              <p class="text-lg text-ink">{s.summary}</p>
              <p class="mt-2 leading-relaxed text-muted">{s.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="process-title" class="border-t border-line">
    <div class="container-site py-20 md:py-28">
      <h2 id="process-title" class="label text-muted">How we work</h2>
      <ol class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((step, i) => (
            <li class="border-t border-ink pt-6" data-reveal>
              <p class="meta">Step {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-xl font-light tracking-tight uppercase">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section aria-labelledby="faq-title" class="border-t border-line">
    <div class="container-site grid gap-10 py-20 md:grid-cols-12 md:py-28">
      <h2 id="faq-title" class="label text-muted md:col-span-4">Questions</h2>
      <div class="md:col-span-8">
        {
          faqs.map((f, i) => (
            <details class="faq group border-b border-line first:border-t" name="faq" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg [&::-webkit-details-marker]:hidden">
                {f.q}
                <span aria-hidden="true" class="relative grid h-6 w-6 shrink-0 place-items-center">
                  <span class="absolute h-px w-3.5 bg-current" />
                  <span class="absolute h-3.5 w-px bg-current transition-transform duration-300 group-open:rotate-90" />
                </span>
              </summary>
              <p class="max-w-[60ch] pb-7 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </section>

  <CtaBand />
</BaseLayout>
