---
/** GitHub Pages serves dist/404.html for unknown routes. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/data/paths';
---

<BaseLayout title="Page not found" noindex>
  <section class="container-site pt-16 pb-28 md:pt-28 md:pb-40">
    <h1 class="page-title">Not found</h1>
    <p class="mt-10 max-w-md text-lg leading-relaxed text-muted">This page doesn’t exist — but your next big idea might.</p>
    <a href={href()} class="btn btn-primary mt-10">Back to home <span class="btn-arrow" aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
