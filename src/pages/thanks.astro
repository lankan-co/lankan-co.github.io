---
/** Landing page after a no-JavaScript contact form submission (Web3Forms redirects here). */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/data/paths';
---

<BaseLayout title="Thank you" noindex>
  <section class="container-site pt-16 pb-28 md:pt-28 md:pb-40">
    <h1 class="page-title">Thank you</h1>
    <p class="mt-10 max-w-md text-lg leading-relaxed text-muted">
      Your message is with us. We reply to every enquiry personally, usually within one working day.
    </p>
    <a href={href()} class="btn btn-primary mt-10">Back to home <span class="btn-arrow" aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
